{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visiflow.dev/schemas/visiflow-frontmatter.schema.json",
  "title": "VisiFlow Markdown front matter",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "visiflow": {
          "type": "number",
          "const": 2
        },
        "kind": {
          "type": "string",
          "const": "project"
        },
        "app": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "enum": [
                "ios",
                "android",
                "web",
                "desktop",
                "custom"
              ]
            },
            "initialScreenId": {
              "type": "string",
              "minLength": 1
            },
            "accent": {
              "type": "string"
            },
            "phoneBackgroundColor": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "platform",
            "device",
            "initialScreenId"
          ],
          "additionalProperties": false
        },
        "screens": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parentId": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "contentHeight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "background": {
                "type": "string"
              },
              "backgroundImage": {
                "type": "string"
              },
              "backgroundSize": {
                "type": "string"
              },
              "backgroundPosition": {
                "type": "string"
              },
              "showSystemUi": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "scope": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "app"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "screen"
                      },
                      "screenId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "screenId"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "trigger": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user-event",
                      "lifecycle",
                      "scheduled",
                      "recurring",
                      "polling",
                      "push",
                      "continuous",
                      "custom"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intervalMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cron": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              },
              "defaultState": {
                "type": "string",
                "enum": [
                  "active",
                  "inactive"
