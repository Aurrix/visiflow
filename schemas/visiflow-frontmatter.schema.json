                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              "protocol": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "cadence": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user-event",
                      "lifecycle",
                      "scheduled",
                      "recurring",
                      "polling",
                      "push",
                      "continuous",
                      "custom"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intervalMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cron": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "direction",
              "peer",
              "protocol",
              "description"
            ],
            "additionalProperties": false
