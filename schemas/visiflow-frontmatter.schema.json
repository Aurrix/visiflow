            "type": "string"
          }
        },
        "defaultState": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        },
        "visual": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "borderColor": {
              "type": "string"
            },
            "borderRadius": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "text": {
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "imageFit": {
              "type": "string",
