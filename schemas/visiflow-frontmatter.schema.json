            "required": [
              "id",
              "name",
              "type",
              "description",
              "scope",
              "trigger"
            ],
            "additionalProperties": false
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "placement": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "scenarios": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "screenId": {
                "type": "string",
                "minLength": 1
              },
              "componentStates": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "active",
                    "inactive"
                  ]
                }
              },
              "taskStates": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "active",
                    "inactive"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "componentStates",
              "taskStates"
            ],
            "additionalProperties": false
          }
        },
        "initialScenarioId": {
          "type": "string",
          "minLength": 1
        },
        "componentFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connections": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "component",
                      "task",
                      "system"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "component",
                      "task",
                      "system"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              "protocol": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "cadence": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user-event",
                      "lifecycle",
                      "scheduled",
                      "recurring",
                      "polling",
                      "push",
                      "continuous",
                      "custom"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intervalMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cron": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "source",
              "target",
              "protocol",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "visiflow",
        "kind",
        "app",
        "screens",
        "tasks",
        "systems",
        "scenarios",
        "componentFiles",
        "connections"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "visiflow": {
          "type": "number",
          "const": 2
        },
        "kind": {
          "type": "string",
          "const": "component"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "screenId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
