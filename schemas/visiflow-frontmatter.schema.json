            "kind": {
              "type": "string",
              "enum": [
                "hotspot",
                "container",
                "text",
                "button",
                "input",
                "badge",
                "image"
              ]
            },
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
