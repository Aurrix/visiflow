            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "layout": {
              "type": "object",
              "properties": {
                "horizontal": {
                  "type": "string",
                  "enum": [
                    "absolute",
                    "start",
                    "center",
                    "end"
                  ]
                },
                "row": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "number"
                },
                "justify": {
                  "type": "string",
                  "enum": [
                    "start",
                    "center",
                    "end",
                    "space-between"
                  ]
                },
                "gap": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "states": {
              "type": "object",
              "properties": {
                "active": {
                  "type": "object",
                  "properties": {
                    "background": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "borderColor": {
                      "type": "string"
                    },
                    "borderRadius": {
                      "type": "number",
                      "minimum": 0
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "src": {
                      "type": "string"
                    },
                    "imageFit": {
                      "type": "string",
                      "enum": [
                        "cover",
                        "contain",
                        "fill"
                      ]
                    },
                    "imagePosition": {
                      "type": "string"
                    },
                    "imageOpacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                },
                "inactive": {
                  "type": "object",
                  "properties": {
                    "background": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "borderColor": {
                      "type": "string"
                    },
                    "borderRadius": {
                      "type": "number",
                      "minimum": 0
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "src": {
                      "type": "string"
                    },
                    "imageFit": {
                      "type": "string",
                      "enum": [
                        "cover",
                        "contain",
                        "fill"
                      ]
                    },
                    "imagePosition": {
                      "type": "string"
                    },
                    "imageOpacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
